# Public frontend configuration
VITE_APP_NAME=Kariuki Kagunda Lawfirm OS
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/

# Runtime
NODE_ENV=production
APP_BASE_URL=https://lawos.example.com
APP_TIMEZONE=Africa/Nairobi

# PostgreSQL
POSTGRES_DB=kklaw
POSTGRES_USER=kklaw
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://kklaw:CHANGE_ME@postgres:5432/kklaw?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Session
SESSION_COOKIE_NAME=kklaw_session
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
SESSION_TTL_SECONDS=604800

# Files
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/data/documents
MAX_UPLOAD_BYTES=52428800

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lawos.example.com/api/v1/integrations/google/callback

# Email
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# WhatsApp
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Backups - configure outside the application as needed
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ==============================================================
# FULL PRODUCT VPS ENVIRONMENT CONTRACT
# All values below are placeholders. Never commit real secrets.
# ==============================================================

NODE_ENV=development
PUBLIC_APP_URL=http://localhost
API_BASE_URL=http://api:3000
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@postgres:5432/kklaw
REDIS_URL=redis://redis:6379
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
SESSION_COOKIE_NAME=kklaw_session

# Private document storage
STORAGE_DRIVER=local
LOCAL_DOCUMENT_ROOT=/srv/kklaw/data/documents
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Outbound mail profile. Prefer DB-configured provider records; these can bootstrap system email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

# Google OAuth bootstrap
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft OAuth bootstrap
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=

# Messaging/payment providers
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
AFRICAS_TALKING_API_KEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Backup target
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Error/observability integrations are optional and environment-specific.
ERROR_TRACKING_DSN=
