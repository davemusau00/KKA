generator client {
  provider               = "prisma-client"
  output                 = "../packages/database/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum SettingScope {
  SYSTEM
  FIRM
  LEGAL_ENTITY
  BRANCH
  DEPARTMENT
  PRACTICE_AREA
  MATTER_TYPE
  WORKFLOW_TEMPLATE
  ROLE
  TEAM
  USER
  CLIENT
  MATTER
  DOCUMENT_TEMPLATE
  INTEGRATION_CONNECTION
  PORTAL_PROFILE
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
  JSON
  SECRET
  ASSET
  DURATION
}

enum SettingSensitivity {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SECRET
}

enum SettingLifecycle {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  ACTIVE
  SUPERSEDED
  DEPRECATED
  ARCHIVED
}

enum IntegrationKind {
  SMTP
  IMAP
  GOOGLE_WORKSPACE
  MICROSOFT_365
  WHATSAPP_CLOUD
  SMS_AFRICAS_TALKING
  MPESA_DARAJA
  JUDICIARY
  S3_STORAGE
  WEBHOOK
  OTHER
}

enum IntegrationStatus {
  UNCONFIGURED
  CONFIGURED
  TESTING
  HEALTHY
  DEGRADED
  FAILED
  DISABLED
  NOT_IMPLEMENTED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MatterStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum MatterPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  WAITING_EXTERNAL
  WAITING_REVIEW
  COMPLETED
  CANCELLED
}

enum CalendarEventType {
  COURT
  CLIENT_MEETING
  INTERNAL_MEETING
  MEDICAL
  FILING
  DEADLINE
  TASK_BLOCK
  OTHER
}

enum CalendarEditPolicy {
  FREE
  CONFIRM
  REASON_REQUIRED
  APPROVAL_REQUIRED
  LOCKED
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SIGNED
  FILED
  SERVED
  REJECTED
  SUPERSEDED
  ARCHIVED
}

enum DocumentConfidentiality {
  STANDARD
  RESTRICTED
  PARTNER_ONLY
  SEALED
}

enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum FundType {
  OFFICE
  CLIENT
  PETTY_CASH
  MOBILE_MONEY
}

enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  DISBURSED
  RECONCILED
  VOID
}

enum FeeNoteStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  SETTLED_FROM_TRUST
  PAID
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum DeliveryStatus {
  QUEUED
  PROVIDER_ACCEPTED
  SENT
  DELIVERED
  READ
  BOUNCED
  COMPLAINED
  DEFERRED
  FAILED
  CANCELLED
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum MarkAssetType {
  FIRM_SEAL
  BRANCH_SEAL
  LOGO
  RECEIVED_STAMP
  PAID_STAMP
  APPROVED_STAMP
  CERTIFIED_COPY_STAMP
  CONFIDENTIAL_STAMP
  DRAFT_STAMP
  COPY_STAMP
  INTERNAL_REVIEW_STAMP
  CUSTOM_OPERATIONAL_MARK
}

enum MarkApplicationStatus {
  PENDING
  APPLIED
  FAILED
  REVOKED
}

enum SigningTransactionStatus {
  CREATED
  PENDING_AUTH
  PENDING_APPROVAL
  SIGNED
  FAILED
  CANCELLED
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum LeaveStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  REPAIR
  RETIRED
  LOST
}

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Firm {
  id            String        @id @default(cuid())
  name          String
  shortName     String?
  timezone      String        @default("Africa/Nairobi")
  locale        String        @default("en-KE")
  currency      String        @default("KES")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  legalEntities LegalEntity[]
  branches      Branch[]
  departments   Department[]
  teams         Team[]
  users         User[]
  clients       Client[]
  intakes       Intake[]
  matters       Matter[]
  workflows     WorkflowTemplate[]
  settings      SettingValue[]
  integrations  IntegrationConnection[]
  roles         Role[]
  directory     DirectoryContact[]
  ledgerAccounts LedgerAccount[]
  vendors       Vendor[]
  assets        Asset[]
  projects      InternalProject[]
  knowledgeItems KnowledgeItem[]
}

model LegalEntity {
  id              String   @id @default(cuid())
  firmId          String
  name            String
  registrationNo  String?
  kraPin          String?
  vatRegistration String?
  defaultCurrency String   @default("KES")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  firm     Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  branches Branch[]
  matters  Matter[]

  @@index([firmId])
}

model Branch {
  id                    String   @id @default(cuid())
  firmId                String
  legalEntityId         String?
  name                  String
  code                  String
  address               String?
  postalAddress         String?
  phone                 String?
  email                 String?
  timezone              String   @default("Africa/Nairobi")
  defaultCourtStation   String?
  numberingPrefix       String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  firm             Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  legalEntity      LegalEntity?  @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  homeUsers         User[]        @relation("HomeBranch")
  userBranches      UserBranch[]
  departments       Department[]
  teams             Team[]
  originatedMatters Matter[]      @relation("OriginatingBranch")
  responsibleMatters Matter[]     @relation("ResponsibleBranch")
  ledgerAccounts    LedgerAccount[]
  assets            Asset[]
  settings          SettingValue[]

  @@unique([firmId, code])
  @@index([firmId, active])
}

model Department {
  id          String   @id @default(cuid())
  firmId      String
  branchId    String?
  name        String
  code        String
  managerId   String?
  costCentre  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm       Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager    User?      @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  members    User[]     @relation("UserDepartment")
  teams      Team[]
  settings   SettingValue[]

  @@unique([firmId, code])
}

model Team {
  id             String   @id @default(cuid())
  firmId         String
  branchId       String?
  departmentId   String?
  name           String
  code           String
  managerId      String?
  practiceArea   String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  firm        Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager     User?       @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  memberships UserTeam[]
  settings    SettingValue[]
  assignments MatterAssignment[]

  @@unique([firmId, code])
}

model User {
  id                  String     @id @default(cuid())
  firmId              String
  homeBranchId        String?
  departmentId        String?
  email               String     @unique
  fullName            String
  phone               String?
  jobTitle            String?
  admissionNumber     String?
  passwordHash        String?
  status              UserStatus @default(INVITED)
  locale              String     @default("en-KE")
  timezone            String     @default("Africa/Nairobi")
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  firm               Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  homeBranch         Branch?     @relation("HomeBranch", fields: [homeBranchId], references: [id], onDelete: SetNull)
  department         Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments Department[] @relation("DepartmentManager")
  managedTeams       Team[]       @relation("TeamManager")
  roles              UserRole[]
  branches           UserBranch[]
  teams              UserTeam[]
  invites            UserInvite[]
  supervisedMatters  Matter[]     @relation("MatterSupervisor")
  stageOwnedMatters  Matter[]     @relation("MatterStageOwner")
  assignments        MatterAssignment[]
  tasksAssigned      Task[]       @relation("TaskAssignee")
  tasksCreated       Task[]       @relation("TaskCreator")
  calendarOrganized  CalendarEvent[] @relation("CalendarOrganizer")
  calendarAssigned   CalendarEvent[] @relation("CalendarAssignee")
  documentsOwned     Document[]   @relation("DocumentOwner")
  versionsUploaded   DocumentVersion[] @relation("DocumentVersionUploader")
  settings           SettingValue[]
  signatureProfile   SignatureProfile?
  signatureDelegationsAsDelegate SignatureDelegation[] @relation("SignatureDelegateUser")
  leaveRequests      LeaveRequest[] @relation("LeaveRequester")
  leaveApprovals     LeaveRequest[] @relation("LeaveApprover")
  assetAssignments   AssetAssignment[]
  projectMemberships ProjectMember[]
  meetingParticipation MeetingParticipant[]
}

model UserBranch {
  userId   String
  branchId String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model UserTeam {
  userId   String
  teamId   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
}

model UserInvite {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Role {
  id          String   @id @default(cuid())
  firmId      String
  key         String
  name        String
  description String?
  system      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm        Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]
  settings    SettingValue[]

  @@unique([firmId, key])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  category    String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model SettingDefinition {
  id                       String             @id @default(cuid())
  key                      String             @unique
  category                 String
  label                    String
  description              String
  valueType                SettingValueType
  allowedScopes            SettingScope[]
  defaultValue             Json?
  validationSchema         Json?
  mergeStrategy            String             @default("replace")
  sensitivity              SettingSensitivity @default(INTERNAL)
  requiresApproval         Boolean            @default(false)
  requiresReason           Boolean            @default(false)
  effectiveDatingSupported Boolean            @default(false)
  restartRequired          Boolean            @default(false)
  featureDependencyKeys    String[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  values SettingValue[]
}

model SettingValue {
  id             String           @id @default(cuid())
  definitionId   String
  firmId         String?
  branchId       String?
  roleId         String?
  userId         String?
  departmentId   String?
  teamId         String?
  scopeType      SettingScope
  scopeId        String
  value          Json?
  secretRefId    String?
  lifecycle      SettingLifecycle @default(ACTIVE)
  version        Int              @default(1)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  changeReason   String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())

  definition SettingDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  secret     SecretRecord?     @relation(fields: [secretRefId], references: [id], onDelete: SetNull)
  firm       Firm?             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  branch     Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role       Role?             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  team       Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([definitionId, scopeType, scopeId, lifecycle])
  @@index([firmId])
}

model SecretRecord {
  id          String   @id @default(cuid())
  purpose     String
  ciphertext  Bytes
  iv          Bytes
  authTag     Bytes
  keyVersion  Int
  createdAt   DateTime @default(now())
  rotatedAt   DateTime?

  settingValues SettingValue[]
  integrations IntegrationConnection[]
}

model IntegrationConnection {
  id             String            @id @default(cuid())
  firmId         String
  kind           IntegrationKind
  name           String
  scopeType      SettingScope      @default(FIRM)
  scopeId        String
  publicConfig   Json
  secretRefId    String?
  status         IntegrationStatus @default(UNCONFIGURED)
  enabled        Boolean           @default(false)
  lastTestAt     DateTime?
  lastHealthyAt  DateTime?
  lastError      String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  firm   Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  secret SecretRecord? @relation(fields: [secretRefId], references: [id], onDelete: SetNull)
  senderIdentities SenderIdentity[]
  inboundMailboxes InboundMailbox[]
  signingProviders SigningProviderConnection[]

  @@unique([firmId, name])
  @@index([firmId, kind, status])
}

model NumberSequence {
  id          String   @id @default(cuid())
  firmId      String
  branchId    String   @default("__GLOBAL__")
  entityType  String
  year        Int      @default(0)
  lastValue   Int      @default(0)
  pattern     String   @default("{firm}/{practice}/{year}/{seq:5}")
  updatedAt   DateTime @updatedAt

  @@unique([firmId, branchId, entityType, year])
}

model Client {
  id                     String   @id @default(cuid())
  firmId                 String
  clientNumber           String?  @unique
  type                   String   @default("PERSON")
  displayName            String
  legalName              String?
  firstName              String?
  lastName               String?
  idNumber               String?
  kraPin                 String?
  phone                  String?
  alternatePhone         String?
  email                  String?
  postalAddress          String?
  physicalAddress        String?
  preferredContactMethod String?  @default("PHONE")
  status                 String   @default("ACTIVE")
  kycStatus              String   @default("PENDING")
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matters   Matter[]
  intakes   Intake[]

  @@index([firmId, displayName])
  @@index([firmId, phone])
  @@index([firmId, idNumber])
}

model Intake {
  id                String   @id @default(cuid())
  firmId            String
  clientId          String?
  intakeNumber      String?  @unique
  source            String?
  referrerName      String?
  clientName        String
  phone             String
  email             String?
  nationalId        String?
  incidentDate      DateTime?
  incidentLocation  String?
  briefDescription  String
  practiceArea      String
  matterType        String?
  assignedOwnerId   String?
  disposition       String   @default("NEW")
  notes             String?
  convertedMatterId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  firm          Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client        Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  parties       IntakeParty[]
  conflictChecks ConflictCheck[]
  kycRecords    KycRecord[]

  @@index([firmId, disposition, createdAt])
  @@index([firmId, phone])
}

model IntakeParty {
  id              String @id @default(cuid())
  intakeId        String
  name            String
  role            String
  idOrRegNumber   String?
  phone           String?
  email           String?
  insuranceCompany String?
  policyOrClaimNumber String?
  notes           String?

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
}

model ConflictCheck {
  id                  String   @id @default(cuid())
  intakeId            String?
  matterId            String?
  checkedByUserId     String
  status              String
  partiesSearched     Json
  matchesFound        Json
  clearanceNotes      String?
  clearedByPartnerId  String?
  checkedAt           DateTime @default(now())
  clearedAt           DateTime?

  intake Intake? @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([intakeId, checkedAt])
}

model KycRecord {
  id                    String   @id @default(cuid())
  intakeId              String
  idDocumentType        String
  idNumber              String
  idVerified            Boolean  @default(false)
  kycDocumentIds        String[]
  warrantToActSigned    Boolean  @default(false)
  retainerAgreementSigned Boolean @default(false)
  retainerAgreedAmount  Decimal? @db.Decimal(18, 2)
  retainerDepositPaid   Boolean  @default(false)
  depositReceiptRef     String?
  termsAccepted         Boolean  @default(false)
  partnerApproval       String   @default("PENDING")
  approvedByUserId      String?
  approvedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
}

model Matter {
  id                  String         @id @default(cuid())
  firmId              String
  legalEntityId       String?
  clientId            String
  internalReference   String         @unique
  title               String
  practiceArea        String
  matterType          String
  workflowVersionId   String?
  originatingBranchId String
  responsibleBranchId String
  supervisingUserId   String
  currentStageOwnerId String?
  courtClerkId        String?
  financeContactId    String?
  currentStageId      Int            @default(1)
  priority            MatterPriority @default(MEDIUM)
  status              MatterStatus   @default(ACTIVE)
  summary             String?
  nextAction          String?
  openedAt            DateTime       @default(now())
  lastActivityAt      DateTime       @default(now())
  closedAt            DateTime?
  closureReason       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  firm              Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  legalEntity       LegalEntity?    @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  originatingBranch Branch          @relation("OriginatingBranch", fields: [originatingBranchId], references: [id], onDelete: Restrict)
  responsibleBranch Branch          @relation("ResponsibleBranch", fields: [responsibleBranchId], references: [id], onDelete: Restrict)
  supervisor        User            @relation("MatterSupervisor", fields: [supervisingUserId], references: [id], onDelete: Restrict)
  currentStageOwner User?           @relation("MatterStageOwner", fields: [currentStageOwnerId], references: [id], onDelete: SetNull)
  workflowVersion  WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)
  assignments       MatterAssignment[]
  accesses          MatterAccess[]
  parties           MatterParty[]
  proceedings       CourtProceeding[]
  tasks             Task[]
  deadlines         Deadline[]
  calendarEvents    CalendarEvent[]
  documents         Document[]
  stageInstances    MatterStageInstance[]
  handoffs          StageHandoff[]
  expenses          ExpenseRequest[]
  feeNotes          FeeNote[]
  journalEntries    JournalEntry[]
  auditEvents       AuditEvent[]
  channels          CommunicationChannel[]
  meetings          Meeting[]
  customValues      CustomFieldValue[]
  personalInjuryCase PersonalInjuryCase?

  @@index([firmId, status, practiceArea])
  @@index([responsibleBranchId, status])
  @@index([currentStageOwnerId, status])
  @@index([lastActivityAt])
}

model MatterAssignment {
  id         String   @id @default(cuid())
  matterId   String
  userId     String?
  teamId     String?
  roleKey    String
  startsAt   DateTime @default(now())
  endsAt     DateTime?
  primary    Boolean  @default(false)
  createdAt  DateTime @default(now())

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([matterId, roleKey, endsAt])
}

model MatterAccess {
  id        String   @id @default(cuid())
  matterId  String
  userId    String?
  roleId    String?
  teamId    String?
  access    String
  reason    String?
  createdAt DateTime @default(now())

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
}

model MatterParty {
  id               String @id @default(cuid())
  matterId         String
  partyType        String
  name             String
  organizationName String?
  idNumber         String?
  phone            String?
  email            String?
  roleDescription  String?
  notes            String?

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId, partyType])
  @@index([name])
}

model WorkflowTemplate {
  id          String   @id @default(cuid())
  firmId      String
  name        String
  practiceArea String
  matterType  String
  description String?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm      Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  versions  WorkflowVersion[]

  @@unique([firmId, practiceArea, matterType, name])
}

model WorkflowVersion {
  id            String                @id @default(cuid())
  templateId    String
  version       Int
  status        WorkflowVersionStatus @default(DRAFT)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stages   WorkflowStage[]
  matters  Matter[]

  @@unique([templateId, version])
}

model WorkflowStage {
  id                    String   @id @default(cuid())
  workflowVersionId     String
  stageNumber           Int
  code                  String
  name                  String
  description           String?
  targetDurationDays    Int      @default(0)
  responsibleRoleKeys   String[]
  assignmentStrategy    String? 
  requiresApproval      Boolean  @default(false)
  approvalRoleKey       String?
  allowedNextStageCodes String[]
