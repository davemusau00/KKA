  evidenceDocumentId    String?
  notes                 String?

  liability PiLiabilityAssessment @relation(fields: [liabilityAssessmentId], references: [id], onDelete: Cascade)
}

model PiNegotiationEntry {
  id               String   @id @default(cuid())
  personalInjuryId String
  occurredAt       DateTime @default(now())
  party            String
  direction        String
  amount           Decimal? @db.Decimal(18,2)
  status           String?
  notes            String?
  documentId       String?
  recordedById     String

  personalInjury PersonalInjuryCase @relation(fields: [personalInjuryId], references: [id], onDelete: Cascade)
  @@index([personalInjuryId, occurredAt])
}

model PiHearingBrief {
  id               String   @id @default(cuid())
  personalInjuryId String   @unique
  courtEventId     String?
  issues           Json?
  witnesses        Json?
  documentChecklist Json?
  opposingPosition String?
  settlementPosition String?
  advocateNotes    String?
  ready            Boolean  @default(false)
  readyAt          DateTime?
  readyById        String?
  updatedAt        DateTime @updatedAt

  personalInjury PersonalInjuryCase @relation(fields: [personalInjuryId], references: [id], onDelete: Cascade)
}

model PiJudgmentAward {
  id               String   @id @default(cuid())
  personalInjuryId String   @unique
  judgmentDate     DateTime?
  liabilityPercent Decimal? @db.Decimal(8,3)
  generalDamages   Decimal  @default(0) @db.Decimal(18,2)
  specialDamages   Decimal  @default(0) @db.Decimal(18,2)
  futureMedical    Decimal  @default(0) @db.Decimal(18,2)
  costsAmount      Decimal  @default(0) @db.Decimal(18,2)
  interestAmount   Decimal  @default(0) @db.Decimal(18,2)
  totalAward       Decimal  @default(0) @db.Decimal(18,2)
  paymentDeadline  DateTime?
  appealDeadline   DateTime?
  appealRecommended Boolean @default(false)
  judgmentDocumentId String?
  decreeDocumentId String?
  notes            String?
  updatedAt        DateTime @updatedAt

  personalInjury PersonalInjuryCase @relation(fields: [personalInjuryId], references: [id], onDelete: Cascade)
}

model PiRecoveryAction {
  id               String   @id @default(cuid())
  personalInjuryId String
  actionType       String
  status           String
  amount           Decimal? @db.Decimal(18,2)
  dueAt            DateTime?
  completedAt      DateTime?
  counterparty     String?
  reference        String?
  documentId       String?
  notes            String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  personalInjury PersonalInjuryCase @relation(fields: [personalInjuryId], references: [id], onDelete: Cascade)
  @@index([personalInjuryId, status])
}

model PiSettlementDistribution {
  id                  String   @id @default(cuid())
  personalInjuryId    String   @unique
  grossAmount         Decimal  @default(0) @db.Decimal(18,2)
  clientFundsReceived Decimal  @default(0) @db.Decimal(18,2)
  professionalFees    Decimal  @default(0) @db.Decimal(18,2)
  disbursements       Decimal  @default(0) @db.Decimal(18,2)
  otherDeductions     Decimal  @default(0) @db.Decimal(18,2)
  netClientAmount     Decimal  @default(0) @db.Decimal(18,2)
  clientApproved      Boolean  @default(false)
  partnerApproved     Boolean  @default(false)
  paymentMethod       String?
  paymentReference    String?
  paidAt              DateTime?
  settlementStatementDocumentId String?
  dischargeDocumentId String?
  updatedAt           DateTime @updatedAt

  personalInjury PersonalInjuryCase @relation(fields: [personalInjuryId], references: [id], onDelete: Cascade)
  deductions PiSettlementDeduction[]
}

model PiSettlementDeduction {
  id             String @id @default(cuid())
  settlementId   String
  type           String
  description    String
  amount         Decimal @db.Decimal(18,2)
  sourceEntityId String?

  settlement PiSettlementDistribution @relation(fields: [settlementId], references: [id], onDelete: Cascade)
}

model PiClosureRecord {
  id               String   @id @default(cuid())
  personalInjuryId String   @unique
  checklist        Json
  closingNote      String?
  financeReconciled Boolean @default(false)
  documentsComplete Boolean @default(false)
  clientInformed  Boolean @default(false)
  supervisorApproved Boolean @default(false)
  approvedById     String?
  approvedAt       DateTime?
  archivedAt       DateTime?
  updatedAt        DateTime @updatedAt

  personalInjury PersonalInjuryCase @relation(fields: [personalInjuryId], references: [id], onDelete: Cascade)
}

// General document-generation templates are separate from immutable user files.
model DocumentTemplate {
  id           String   @id @default(cuid())
  firmId       String
  key          String
  name         String
  category     String
  practiceArea String?
  matterType   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions DocumentTemplateVersion[]
  @@unique([firmId, key])
  @@index([firmId, category, active])
}

model DocumentTemplateVersion {
  id             String   @id @default(cuid())
  templateId     String
  version        Int
  status         WorkflowVersionStatus @default(DRAFT)
  sourceStoragePath String?
  sourceMimeType String?
  mergeSchema    Json?
  content        String?
  createdById    String
  publishedAt    DateTime?
  createdAt      DateTime @default(now())

  template DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  @@unique([templateId, version])
}

model SystemJobRecord {
  id          String              @id @default(cuid())
  queue       String
  jobName     String
  jobId       String?
  status      AutomationRunStatus @default(QUEUED)
  payloadHash String?
  attempts    Int                 @default(0)
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime            @default(now())

  @@index([queue, status, createdAt])
}

// Durable, idempotent document rendering/application request. Payload is a pinned snapshot.
model DocumentOperation {
  id String @id @default(cuid())
  firmId String
  actorId String
  documentId String
  kind String
  idempotencyKey String
  payloadHash String
  payload Json
  status String @default("QUEUED")
  approvalRequestId String? @unique
  outputVersionId String?
  outputDocxVersionId String?
  error String?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([firmId, idempotencyKey])
  @@index([firmId, documentId, createdAt])
}
