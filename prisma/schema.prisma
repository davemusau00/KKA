// PERSONAL INJURY STRUCTURED CASE DATA
// These models complement the generic workflow/document/task engine. They are
// intentionally matter-linked and can evolve without hard-coding the UI.
// =============================================================================
model PersonalInjuryCase {
  id                    String   @id @default(cuid())
  matterId              String   @unique
  incidentDate          DateTime?
  incidentTime          String?
  incidentLocation      String?
  accidentNarrative     String?
  obNumber              String?
  policeStation         String?
  investigatingOfficer  String?
  investigatingPhone    String?
  roadConditions        String?
  vehicleRegistrationPrimary String?
  insurerClaimReference String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  matter          Matter                  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  vehicles        PiVehicle[]
  witnesses       PiWitness[]
  evidence        PiEvidenceItem[]
  injuries        PiInjury[]
  treatments      PiTreatmentEpisode[]
  medicalReports  PiMedicalReportRequest[]
  liability       PiLiabilityAssessment?
  negotiations    PiNegotiationEntry[]
  hearingBrief    PiHearingBrief?
  judgment        PiJudgmentAward?
  recoveryActions PiRecoveryAction[]
  settlement      PiSettlementDistribution?
  closure         PiClosureRecord?
}

model PiVehicle {
  id               String @id @default(cuid())
  personalInjuryId String
  registrationNo   String
  makeModel         String?
  ownerName         String?
  driverName        String?
