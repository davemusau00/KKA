{$WEB_DOMAIN:os.kariukikagunda.com} {
    encode zstd gzip

    root * /srv/web
    try_files {path} /index.html
    file_server

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        -Server
    }

    log {
        output stdout
        format json
    }
}

{$API_DOMAIN:api.kariukikagunda.com} {
    encode zstd gzip
    reverse_proxy api:3000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    log {
        output stdout
        format json
    }
}
