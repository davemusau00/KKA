# =============================================================================
# KARIUKI KAGUNDA & CO. ADVOCATES OS - BACKEND ENVIRONMENT
# Copy to .env on the VPS. Never commit real values.
# =============================================================================

NODE_ENV=development
APP_NAME=KKA Lawfirm OS
APP_URL=http://localhost:8080
API_HOST=0.0.0.0
API_PORT=3000
API_PREFIX=/api/v1
TRUST_PROXY=true

# PostgreSQL 18
POSTGRES_DB=kka_os
POSTGRES_USER=kka_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
DATABASE_URL=postgresql://kka_app:CHANGE_ME_LONG_RANDOM@postgres:5432/kka_os?schema=public

# Redis 8.2
REDIS_URL=redis://redis:6379/0
SESSION_COOKIE_NAME=kka_sid
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=

# Authentication
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
INVITE_TOKEN_TTL_HOURS=48

# 32-byte base64 key, for example:
# openssl rand -base64 32
APP_ENCRYPTION_KEY_BASE64=CHANGE_ME_32_BYTE_BASE64_KEY
ENCRYPTION_KEY_VERSION=1

# Local private storage
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/srv/kklaw/data/documents
MARK_STORAGE_ROOT=/srv/kklaw/data/marks
MAX_UPLOAD_BYTES=52428800

# Optional S3-compatible storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# CORS / web
WEB_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Outbound mail default. The preferred production path is DB-backed IntegrationConnection.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

# Worker
WORKER_CONCURRENCY=8
MAIL_QUEUE_CONCURRENCY=4
NOTIFICATION_QUEUE_CONCURRENCY=8
DOCUMENT_QUEUE_CONCURRENCY=2
AUTOMATION_QUEUE_CONCURRENCY=4

# Backup destination for restic
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Logging
LOG_LEVEL=info

# Deployment
APP_DOMAIN=law.example.com
KKA_DATA_ROOT=/srv/kklaw/data
WEB_DIST_PATH=../apps/web/dist

# One-time seed administrator. Set for first seed only, then remove from the environment.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_PASSWORD=
WEBHOOK_QUEUE_CONCURRENCY=4
