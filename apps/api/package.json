{
  "name": "@kka/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/foundation.test.ts test/website-json.test.ts",
    "test:access": "tsx --test test/record-access.test.ts test/notifications-access.test.ts test/personal-injury-access.test.ts test/audit-access.test.ts test/finance-access.test.ts test/calendar-access.test.ts test/calendar-outcome.test.ts test/tasks-access.test.ts test/deadlines.test.ts",
    "test:documents": "tsx --test test/document-workflows.test.ts",
    "test:website": "node --test test/website-integration.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.888.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "^8.3.0",
    "@kka/contracts": "workspace:*",
    "@kka/database": "workspace:*",
    "@kka/document-engine": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-fastify": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/websockets": "11.1.6",
    "argon2": "0.44.0",
    "bullmq": "5.58.5",
    "fastify": "5.6.0",
    "ioredis": "5.7.0",
    "nodemailer": "7.0.6",
    "pdf-lib": "1.17.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "zod": "4.1.5",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.3.1",
    "@types/nodemailer": "7.0.1",
    "jest": "30.1.3",
    "ts-jest": "29.4.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
